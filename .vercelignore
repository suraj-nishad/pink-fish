# Vercel Deployment Ignore File
# Reduces serverless function size by excluding unnecessary files

# Development files
.git/
.github/
.vscode/
.idea/
*.md
!README.md

# Tests and scripts
test_*.py
generate_month_data.py

# Documentation (keep only README)
QUICK_START.md
API_ENDPOINTS_REFERENCE.md
ML_MODELS_DOCUMENTATION.md
SIMULATION_DOCUMENTATION.md
SETUP_COMPLETE_SUMMARY.md
API_TEST_RESULTS.md
PROJECT_STATUS_FINAL.md
VERCEL_DEPLOYMENT.md

# Logs
*.log
server.log

# Virtual environments
venv/
env/
.venv/
ENV/

# Python cache
__pycache__/
*.pyc
*.pyo
*.pyd
.pytest_cache/

# Data files (keep only essential)
data/plant_data_30days.csv
data/plant_data_48h.csv

# ML Models (will regenerate on first run)
backend/models/*.pkl

# Git
.gitignore
.gitattributes
