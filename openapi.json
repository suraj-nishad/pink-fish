  "components": {
    "schemas": {
      "AlertModel": {
        "properties": {
          "type": {
            "type": "string",
            "title": "Type"
          },
          "message": {
            "type": "string",
            "title": "Message"
          },
          "timestamp": {
            "type": "string",
            "title": "Timestamp"
          }
        },
        "type": "object",
        "required": [
          "type",
          "message",
          "timestamp"
        ],
        "title": "AlertModel"
      },
      "AnomalyDetectionRequest": {
        "properties": {
          "zone": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Zone",
            "description": "Specific zone to analyze, or None for all zones"
          },
          "hours": {
            "type": "integer",
            "maximum": 168,
            "minimum": 1,
            "title": "Hours",
            "description": "Hours of data to analyze",
            "default": 24
          }
        },
        "type": "object",
        "title": "AnomalyDetectionRequest"
      },
      "AnomalyDetectionResponse": {
        "properties": {
          "total_records": {
            "type": "integer",
            "title": "Total Records"
          },
          "anomalies_detected": {
            "type": "integer",
            "title": "Anomalies Detected"
          },
          "anomaly_rate": {
            "type": "number",
            "title": "Anomaly Rate"
          },
          "results": {
            "items": {
              "$ref": "#/components/schemas/AnomalyResult"
            },
            "type": "array",
            "title": "Results"
          },
          "timestamp": {
            "type": "string",
            "title": "Timestamp"
          }
        },
        "type": "object",
        "required": [
          "total_records",
          "anomalies_detected",
          "anomaly_rate",
          "results",
          "timestamp"
        ],
        "title": "AnomalyDetectionResponse"
      },
      "AnomalyResult": {
        "properties": {
          "timestamp": {
            "type": "string",
            "title": "Timestamp"
          },
          "zone": {
            "type": "string",
            "title": "Zone"
          },
          "is_anomaly": {
            "type": "boolean",
            "title": "Is Anomaly"
          },
          "anomaly_score": {
            "type": "number",
            "title": "Anomaly Score"
          },
          "confidence": {
            "type": "number",
            "title": "Confidence"
          },
          "metrics": {
            "additionalProperties": {
              "type": "number"
            },
            "type": "object",
            "title": "Metrics"
          }
        },
        "type": "object",
        "required": [
          "timestamp",
          "zone",
          "is_anomaly",
          "anomaly_score",
          "confidence",
          "metrics"
        ],
        "title": "AnomalyResult"
      },
      "ChatOpsRequest": {
        "properties": {
          "query": {
            "type": "string",
            "title": "Query"
          },
          "user": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "User",
            "default": "operator"
          }
        },
        "type": "object",
        "required": [
          "query"
        ],
        "title": "ChatOpsRequest"
      },
      "ChatOpsResponse": {
        "properties": {
          "query": {
            "type": "string",
            "title": "Query"
          },
          "response": {
            "type": "string",
            "title": "Response"
          },
          "related_actions": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Related Actions"
          },
          "confidence": {
            "type": "number",
            "title": "Confidence"
          }
        },
        "type": "object",
        "required": [
          "query",
          "response",
          "related_actions",
          "confidence"
        ],
        "title": "ChatOpsResponse"
      },
      "ConfigModel": {
        "properties": {
          "ENERGY_THRESHOLD_AMBER": {
            "type": "number",
            "title": "Energy Threshold Amber"
          },
          "ENERGY_THRESHOLD_RED": {
            "type": "number",
            "title": "Energy Threshold Red"
          },
          "EFFICIENCY_THRESHOLD_AMBER": {
            "type": "number",
            "title": "Efficiency Threshold Amber"
          },
          "EFFICIENCY_THRESHOLD_RED": {
            "type": "number",
            "title": "Efficiency Threshold Red"
          },
          "CO2_FACTOR": {
            "type": "number",
            "title": "Co2 Factor"
          },
          "COST_PER_KWH": {
            "type": "number",
            "title": "Cost Per Kwh"
          }
        },
        "type": "object",
        "required": [
          "ENERGY_THRESHOLD_AMBER",
          "ENERGY_THRESHOLD_RED",
          "EFFICIENCY_THRESHOLD_AMBER",
          "EFFICIENCY_THRESHOLD_RED",
          "CO2_FACTOR",
          "COST_PER_KWH"
        ],
        "title": "ConfigModel"
      },
      "EnergyAnalysisResponse": {
        "properties": {
          "hotspots": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Hotspots"
          },
          "recommendations": {
            "items": {
              "$ref": "#/components/schemas/RecommendationModel"
            },
            "type": "array",
            "title": "Recommendations"
          },
          "impact": {
            "additionalProperties": {
              "type": "number"
            },
            "type": "object",
            "title": "Impact"
          },
          "timestamp": {
            "type": "string",
            "title": "Timestamp"
          }
        },
        "type": "object",
        "required": [
          "hotspots",
          "recommendations",
          "impact",
          "timestamp"
        ],
        "title": "EnergyAnalysisResponse"
      },
      "EnergyForecastRequest": {
        "properties": {
          "zone": {
            "type": "string",
            "title": "Zone",
            "description": "Zone to forecast"
          },
          "hours_ahead": {
            "type": "integer",
            "maximum": 168,
            "minimum": 1,
            "title": "Hours Ahead",
            "description": "Hours to forecast",
            "default": 24
          },
          "current_temp": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Current Temp",
            "description": "Current temperature"
          },
          "current_efficiency": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Current Efficiency",
            "description": "Current efficiency"
          }
        },
        "type": "object",
        "required": [
          "zone"
        ],
        "title": "EnergyForecastRequest"
      },
      "EnergyForecastResponse": {
        "properties": {
          "zone": {
            "type": "string",
            "title": "Zone"
          },
          "forecast_hours": {
            "type": "integer",
            "title": "Forecast Hours"
          },
          "forecast": {
            "items": {
              "$ref": "#/components/schemas/ForecastPoint"
            },
            "type": "array",
