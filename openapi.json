    "/api/analyze-energy": {
      "post": {
        "tags": [
          "AI Analysis"
        ],
        "summary": "Analyze Energy",
        "description": "Trigger energy analysis workflow via IBM watsonx Orchestrate\nAnalyzes energy consumption patterns and provides AI-powered recommendations",
        "operationId": "analyze_energy_api_analyze_energy_post",
        "parameters": [
          {
            "name": "zones",
            "in": "query",
            "required": true,
            "schema": {
              "type": "array",
              "items": {
                "type": "string"
              },
              "description": "Zones to analyze (e.g., ['Paint Shop', 'Assembly'])",
              "title": "Zones"
            },
            "description": "Zones to analyze (e.g., ['Paint Shop', 'Assembly'])"
          },
          {
            "name": "timeframe",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "description": "Analysis timeframe",
              "default": "last_24h",
              "title": "Timeframe"
            },
            "description": "Analysis timeframe"
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
