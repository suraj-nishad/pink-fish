{
  "openapi": "3.1.0",
  "info": {
    "title": "PlantOps Digital Twin Dashboard APIs - Chatops Query",
    "description": "Handle natural language queries about plant status\nUses IBM watsonx Orchestrate for intelligent query processing",
    "version": "1.0.0"
  },
  "servers": [
    {
      "url": "https://pink-fish-production.up.railway.app",
      "description": "Production Server"
    },
    {
      "url": "http://127.0.0.1:8000",
      "description": "Local Development Server"
    }
  ],
  "paths": {
    "/api/chatops": {
      "post": {
        "tags": [
          "ChatOps"
        ],
        "summary": "Chatops Query",
        "description": "Handle natural language queries about plant status\nUses IBM watsonx Orchestrate for intelligent query processing",
        "operationId": "chatops_query_api_chatops_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ChatOpsRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ChatOpsResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "ChatOpsResponse": {
        "properties": {
          "query": {
            "type": "string",
            "title": "Query"
          },
          "response": {
            "type": "string",
            "title": "Response"
          },
          "related_actions": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Related Actions"
          },
          "confidence": {
            "type": "number",
            "title": "Confidence"
          }
        },
        "type": "object",
        "required": [
          "query",
          "response",
          "related_actions",
          "confidence"
        ],
        "title": "ChatOpsResponse"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "ChatOpsRequest": {
        "properties": {
          "query": {
            "type": "string",
            "title": "Query",
            "description": "Natural language query about plant operations",
            "examples": [
              "Why is Paint Shop red?",
              "What zones need maintenance?",
              "Show me energy consumption trends"
            ]
          },
          "user": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "User",
            "description": "User identifier",
            "default": "operator"
          }
        },
        "type": "object",
        "required": [
          "query"
        ],
        "title": "ChatOpsRequest",
        "examples": [
          {
            "query": "Why is Paint Shop showing red status?",
            "user": "operator_123"
          }
        ]
      },
      "ValidationError": {
        "properties": {
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "type": "array",
            "title": "Location"
          },
          "msg": {
            "type": "string",
            "title": "Message"
          },
          "type": {
            "type": "string",
            "title": "Error Type"
          }
        },
        "type": "object",
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError"
      }
    }
  }
}