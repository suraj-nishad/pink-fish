{
  "openapi": "3.1.0",
  "info": {
    "title": "PlantOps Digital Twin Dashboard APIs - Get Config",
    "description": "Get current analysis configuration thresholds",
    "version": "1.0.0"
  },
  "servers": [
    {
      "url": "https://pink-fish-production.up.railway.app",
      "description": "Production Server"
    },
    {
      "url": "http://127.0.0.1:8000",
      "description": "Local Development Server"
    }
  ],
  "paths": {
