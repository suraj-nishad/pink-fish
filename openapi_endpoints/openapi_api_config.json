          "ENERGY_THRESHOLD_RED": {
            "type": "number",
            "title": "Energy Threshold Red"
          },
          "EFFICIENCY_THRESHOLD_AMBER": {
            "type": "number",
            "title": "Efficiency Threshold Amber"
          },
          "EFFICIENCY_THRESHOLD_RED": {
            "type": "number",
            "title": "Efficiency Threshold Red"
          },
          "CO2_FACTOR": {
            "type": "number",
            "title": "Co2 Factor"
          },
          "COST_PER_KWH": {
            "type": "number",
            "title": "Cost Per Kwh"
          }
        },
        "type": "object",
        "required": [
          "ENERGY_THRESHOLD_AMBER",
          "ENERGY_THRESHOLD_RED",
          "EFFICIENCY_THRESHOLD_AMBER",
          "EFFICIENCY_THRESHOLD_RED",
          "CO2_FACTOR",
          "COST_PER_KWH"
